{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Veil Studio",
  "version": "1.0.0",
  "identifier": "com.veil.studio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Veil Studio",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "./icons/installer-icon.ico",
        "uninstallerIcon": "./icons/uninstaller-icon.ico",
        "headerImage": "./icons/header.bmp",
        "sidebarImage": "./icons/sidebar.bmp",
        "template": "custom-installer.nsi"
      }
    }
  }
}